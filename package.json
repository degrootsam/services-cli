{
  "name": "bbs-cli",
  "version": "1.0.0",
  "description": "A CLI for the Betty Blocks Platform",
  "keywords": [
    "bettyblocks",
    "cli"
  ],
  "license": "MIT",
  "author": "Sam de Groot",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "sync": "git pull && (git diff --quiet && git diff --cached --quiet && git ls-files --others --exclude-standard) || (git add . && git commit -m 'sync' && git push)"
  },
  "bin": {
    "bbs": "./dist/index.js"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@jest/globals": "^29.7.0",
    "@types/commander": "^2.12.0",
    "@types/degit": "^2.8.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/semver": "^7.7.0",
    "@types/winston": "^2.4.4",
    "babel-jest": "^29.7.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.1"
  },
  "dependencies": {
    "@babel/parser": "^7.26.10",
    "@inquirer/prompts": "^7.3.2",
    "@sveltejs/acorn-typescript": "^1.0.5",
    "@types/acorn": "^4.0.6",
    "@types/archiver": "^6.0.3",
    "acorn": "^8.14.1",
    "acorn-walk": "^8.3.4",
    "archiver": "^7.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "degit": "^2.8.4",
    "esbuild": "^0.25.0",
    "form-data": "^4.0.2",
    "fs-extra": "^11.3.0",
    "graphql": "^16.10.0",
    "jtd": "^0.1.1",
    "keytar": "^7.9.0",
    "nanospinner": "^1.2.2",
    "node-fetch": "^3.3.2",
    "semver": "^7.7.1",
    "winston": "^3.17.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}

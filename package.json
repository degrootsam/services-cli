{
  "name": "bbs-cli",
  "version": "0.0.1",
  "description": "A CLI for the Betty Blocks Platform",
  "keywords": [
    "bettyblocks",
    "cli"
  ],
  "license": "MIT",
  "author": "Sam de Groot",
  "main": "dist/config.js",
  "types": "dist/types/config.d.ts",
  "type": "module",
  "scripts": {
    "test": "bun test src/__tests__",
    "test:watch": "bun test --watch src/__tests__",
    "test:coverage": "bun test --coverage src/__tests__",
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "sync": "git pull && (git diff --quiet && git diff --cached --quiet && git ls-files --others --exclude-standard) || (git add . && git commit -m 'sync' && git push)",
    "update:projects": "trunk actions run update-submodules",
    "setup": "trunk actions run init-submodules",
    "trunk": "trunk",
    "lint": "trunk check --show-existing",
    "lint:fix": "trunk check --fix --show-existing",
    "fmt": "trunk fmt",
    "release": "node scripts/create-release-tag.js",
    "gen:function-schema": "bun run scripts/fetch-functions-schema.ts"
  },
  "bin": {
    "bbs": "./dist/index.js"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.3.14",
    "@types/commander": "^2.12.5",
    "@types/degit": "^2.8.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "@types/winston": "^2.4.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@inquirer/prompts": "^7.10.1",
    "@sveltejs/acorn-typescript": "^1.0.13",
    "@types/acorn": "^4.0.6",
    "@types/archiver": "^6.0.4",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "archiver": "^7.0.1",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "degit": "^2.8.6",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.0",
    "graphql": "^16.14.2",
    "json-schema-to-typescript": "^15.0.4",
    "jtd": "^0.1.1",
    "keytar": "^7.9.0",
    "nanospinner": "^1.2.2",
    "node-fetch": "^3.3.2",
    "semver": "^7.8.5",
    "winston": "^3.19.0"
  },
  "overrides": {
    "@babel/types": "7.29.8"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}

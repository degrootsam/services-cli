{
  "compilerOptions": {
    "target": "ESNext", // Use the latest JavaScript features
    "module": "nodenext", // CommonJS for CLI module format
    "moduleResolution": "Node16", // Node-style module resolution
    "lib": ["ESNext"], // Include ESNext lib features
    "outDir": "dist", // Output compiled JavaScript files to "dist"
    "rootDir": "src", // Set the root directory for TypeScript source files
    "strict": true, // Enable all strict type-checking options
    "esModuleInterop": true, // Ensure compatibility between ES and CommonJS modules
    "skipLibCheck": true, // Skip type checking of declaration files
    "resolveJsonModule": true, // Enable importing JSON files
    "forceConsistentCasingInFileNames": true, // Enforce consistent casing in filenames
    "allowJs": true, // Allow JavaScript files in the project
    "declaration": true, // Generate type declaration files (.d.ts)
    "declarationDir": "./dist/types", // Output declaration files to a separate directory
    "sourceMap": true // Generate source maps for easier debugging
  },
  "include": [
    "src/**/*" // Include all TypeScript files in the "src" directory
  ],
  "exclude": [
    "node_modules", // Exclude the "node_modules" directory
    "dist", // Exclude the "dist" directory (output directory)
    "src/__tests__",
    "src/__mocks__"
  ]
}
